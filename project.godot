; Engine configuration file.
; Edit through Godot when possible; values here form the portable project baseline.
config_version=5

[application]

config/name="Ash at Greyfen"
config/description="A narrative action-adventure set at the rainbound frontier fortress of Greyfen."
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"

[autoload]

SaveSystem="*res://scripts/save_system.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

